[0.000, "o", "\r\n\u001b[1m\u001b[32m[实测] \u001b[0m\u001b[32m200 个 delta 全部送达（merged=200），emit 总耗时 0.000s——emit 返回时事件只是进了缓冲\u001b[0m\r\n"]
[0.052, "o", "\r\n\u001b[1m\u001b[32m[UI] \u001b[0m\u001b[32m刷一帧（8 字）\u001b[0m\r\n"]
[0.070, "o", "\r\n\u001b[1m\u001b[32m[实测] \u001b[0m\u001b[32m200 次渲染合并成 3 帧——刷屏节奏归消费者，不归总线\u001b[0m\r\n\u001b[90m       说明 │ 满了立刻刷（洪峰不攒着），到帧界也刷（尾巴不饿着），二者先到先刷。\u001b[0m\r\n\r\n\u001b[90m  sessions 目录: /Users/rio/repos/myprjs/agent-cookbook/src/baby_event_driven_agent/sessions/stage04\u001b[0m\r\n"]
